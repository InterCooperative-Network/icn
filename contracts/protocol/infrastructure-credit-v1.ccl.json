            "right": { "Literal": { "Int": 0 } }
          }
        },
        {
          "BinOp": {
            "op": "Le",
            "left": { "Var": "new_rate" },
            "right": { "Literal": { "Int": 1000 } }
          }
        }
      ],
      "body": [
        {
          "Assign": {
            "name": "compute_rate",
