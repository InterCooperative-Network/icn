    },
    {
      "name": "get_all_costs",
      "params": [],
      "requires": [],
      "body": [
        {
          "Return": {
            "value": {
              "Map": [
                ["message_cost", { "Var": "message_cost" }],
                ["transaction_cost", { "Var": "transaction_cost" }],
                ["proposal_cost", { "Var": "proposal_cost" }],
                ["compute_base_cost", { "Var": "compute_base_cost" }]
              ]
            }
