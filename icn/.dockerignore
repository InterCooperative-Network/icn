# Rust build artifacts - these are huge and don't need to be in the image
target/
**/target/

# Git files
.git/
.gitignore

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation (not needed in image)
docs/
*.md

# Examples (not needed in image)
examples/

# Scripts (not needed in image)
scripts/

# Temporary files
*.tmp
*.log
*.bak

# OS files
.DS_Store
Thumbs.db

