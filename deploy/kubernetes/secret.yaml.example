# ICN Kubernetes Secrets - EXAMPLE FILE
#
# DO NOT DEPLOY THIS FILE DIRECTLY!
# 1. Copy this file to secret.yaml
# 2. Replace all placeholder values with real secrets
# 3. Apply with: kubectl apply -f secret.yaml
#
# GENERATING SECURE SECRETS:
#   JWT Secret (256-bit):  openssl rand -base64 32
#   DB Password (128-bit): openssl rand -base64 16
#   API Key (256-bit):     openssl rand -hex 32
#
# IMPORTANT: secret.yaml is in .gitignore - NEVER commit real secrets!
#
apiVersion: v1
kind: Secret
metadata:
  name: icn-secrets
  namespace: icn
  labels:
    app: icn
type: Opaque
stringData:
  # JWT Secret for Gateway API authentication (REQUIRED)
  # Generate with: openssl rand -base64 32
  JWT_SECRET: "REPLACE_WITH_GENERATED_SECRET"
  
  # Database credentials (if using external DB)
  # Generate with: openssl rand -base64 16
  DB_PASSWORD: "REPLACE_WITH_GENERATED_SECRET"
  
  # API Keys (optional, uncomment if needed)
  # API_KEY: "REPLACE_WITH_GENERATED_SECRET"
