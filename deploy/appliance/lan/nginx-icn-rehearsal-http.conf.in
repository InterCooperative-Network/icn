# icn-rehearsal — single-origin LAN serving (HTTP variant).
# Rendered by build-image.sh (LAN profile) from
# deploy/appliance/lan/nginx-icn-rehearsal-http.conf.in; @LAN_HOST@ is the
# origin host from ICN_APPLIANCE_LAN_ORIGIN.
#
# Plain HTTP is a deliberate, documented interim posture (the bearer session
# travels unencrypted on the operator's own LAN segment); prefer the https
# template with an operator-supplied internal-CA certificate.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name @LAN_HOST@;

    add_header X-Content-Type-Options nosniff;

    root /usr/share/icn/static/web;

    # Landing page is the front door.
    location = / {
        return 302 /rehearsal-landing/;
    }

    # DEV/DEMO session + status endpoint: loopback-only service; this proxy is
    # the single LAN path to it. Its own server-side origin allowlist and
    # non-production dev gates still apply.
    location /v1/dev/demo/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Gateway API (JWT-authenticated; uniform 401 pre-lookup without a valid
    # credential — ADR-0015).
    location /v1/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Static: rehearsal landing + member shell + fixture pack.
    location / {
        try_files $uri $uri/ =404;
    }
}
