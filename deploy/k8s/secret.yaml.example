# Example secret template
# Copy this to secret.yaml and fill in your values
# DO NOT commit secret.yaml to git!
apiVersion: v1
kind: Secret
metadata:
  name: icn-secrets
  namespace: icn
  labels:
    app: icn
type: Opaque
stringData:
  passphrase: "CHANGE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: icn-passphrase
  namespace: icn
  labels:
    app: icn
type: Opaque
stringData:
  passphrase: "CHANGE_ME"

