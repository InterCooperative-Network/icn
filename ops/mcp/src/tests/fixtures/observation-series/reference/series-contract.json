  "rules": [
    {
      "id": "R1",
      "rule": "Registry sameness is never derivable from a snapshot. Differing schema_version.applied_at proves 'different'; equal stamps prove nothing. Same-registry must be asserted out of band."
    },
    {
      "id": "R2",
      "rule": "A later acquisition.started_at is not authenticated freshness. Refuse an export as 'newer' unless its started_at is strictly later; flag any row timestamp after the export's own started_at."
    },
    {
      "id": "R3",
      "rule": "NULL repo_id / worktree_id / worktree_generation / provider_session_id are UNKNOWN. Never equal to each other, never equal to a value."
    },
    {
      "id": "R4",
      "rule": "withheld:<hex> tokens carry a per-export random salt. Equality is meaningful only within one snapshot; never compare token values across snapshots."
    },
    {
      "id": "R5",
      "rule": "For one session id: repo, provider, provider_session_id, parent_session_id, host, started_at never change. A change means different registry or corruption: refuse."
    },
    {
      "id": "R6",
      "rule": "Lane fields (repo_id, worktree_id, worktree_name, worktree_generation) may change on an existing id, only through re-registration of a known conversation: a lane move changes them together; a recreated lane at the same path changes only worktree_generation."
    },
    {
      "id": "R7",
      "rule": "progress_count never decreases for one id. A new id (release + re-register) restarts at 0."
    },
    {
      "id": "R8",
      "rule": "A session absent from a later export of the same registry has had its row deleted (release). Absence is not staleness, and 'ended' must not be concluded from absence alone."
    },
    {
      "id": "R9",
      "rule": "A stale row is not an ended session: ICN never reaps stale rows. Only an explicit release removes them."
    },
    {
      "id": "R10",
      "rule": "A conversation id appears on at most one row within one export. Across exports of one registry it may map to a NEW session id after release."
    }
  ]
}
