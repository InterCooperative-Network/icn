  },
  "null_rules": {
    "withheld": "A NULL in a column whose disposition is 'withheld' means WITHHELD. It never means absent, none or unknown-to-ICN.",
    "digest": "NULL stays NULL. A non-NULL value becomes 'sha256:<64 hex>'. No value is ever invented.",
    "verbatim": "NULL only where the source had NULL; semantics are the registry's own.",
    "repo_id": "NOT 'NOT NULL': it was added in schema v3 as a nullable TEXT, and registration stores NULL when lane discovery fails or the row predates v3. The export preserves NULL as NULL; it never fabricates a digest and never exposes the original path. Non-null source values ALWAYS export as a valid digest.",
    "worktree_generation": "NULL means the generation is unknown (a pre-v5 row), not 'none'.",
    "provider_session_id": "NULL means the harness conversation id is unknown for that activation."
  },
  "identifiers": {
    "digest": {
      "applies_to": [
        "repo_id",
        "worktree_id"
      ],
      "algorithm": "SHA-256",
      "input": "the UTF-8 bytes of the stored column value, exactly as stored (no normalisation, no trailing newline)",
      "output": "'sha256:' + lowercase hex",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "keyed": false,
      "secret": false,
      "authenticated": false,
      "unguessable": false,
      "recomputable_without_private_inputs": false,
      "recomputable_from_the_raw_value": true,
      "note": "UNKEYED. Anyone who knows or can enumerate the raw value can recompute it, and can therefore CONFIRM a guess. It removes filesystem layout from the file; it is pseudonymisation, not secrecy and not authentication. Stored values are the canonical git paths ICN produced on the registering host (repo_id = git common dir, worktree_id = git dir), so equality needs the same canonical string."
    },
    "claim_path_token": {
      "applies_to": [
        "file_claims.file_path (only when the path is not disclosable)"
      ],
      "formula": "'withheld:' + first 16 lowercase hex of SHA-256( salt || 0x00 || UTF-8(path) )",
      "pattern": "^withheld:[0-9a-f]{16}$",
      "salt": "16 random bytes, fresh for every export, never written anywhere",
      "stability_scope": "within ONE snapshot only: equal paths share a token, tokens are not comparable across snapshots",
      "recomputable_from_snapshot": false,
      "conflict_semantics": "Two rows with the same token are claims on the same withheld path. The ROW is always kept; a withheld path never turns a claim into a non-claim."
    },
    "disclosable_claim_path": {
      "rule": "every '/'-separated segment matches SAFE_SEGMENT and none is '..'; total length <= max_bytes",
      "segment_pattern": "^[A-Za-z0-9._@+=,-]+$",
      "max_bytes": 512,
      "otherwise": "replaced by a token; conservative: spaces and non-ASCII are tokenised"
    },
    "verbatim_text": {
      "applies_to": [
        "id",
        "repo",
        "worktree_name",
        "worktree_generation",
        "provider_session_id",
        "parent_session_id",
        "provider",
        "host",
        "started_at",
        "last_heartbeat",
        "last_progress"
      ],
      "pattern": "^[\\p{L}\\p{N}._:@+ -]{1,256}$",
      "flags": "u",
      "on_violation": "the producer REFUSES the export (SNAPSHOT_VERIFY_FAILED); it never alters the value"
    },
    "numeric_verbatim": [
      "agent_pid",
      "progress_count"
    ]
  },
  "field_policy": {
    "sessions": {
      "verbatim": [
