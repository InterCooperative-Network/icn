{
  "contract_version": "icn-observation-producer-contract/v1",
  "scope": "Producer contract of ICN's RESTRICTED OBSERVATION registry snapshot. Not the full recovery profile, which is a different disclosure policy and must never be substituted for it.",
  "derived_from": [
    "ops/mcp/src/state/snapshot-profile.ts",
    "ops/mcp/src/state/snapshot-export.ts",
    "ops/mcp/src/state/db.ts",
    "ops/mcp/src/cli/snapshot-export.ts",
    "the generated observation.db and its sidecar (types, header, field paths)"
  ],
  "profile": {
    "selector": {
      "sidecar_field": "profile",
      "value": "observation",
      "all_profiles": [
        "full",
        "observation"
      ]
    },
    "policy": {
      "sidecar_field": "disclosure.policy",
      "value": "observation-v1"
    },
    "sidecar_format": {
      "sidecar_field": "format",
      "value": "icn-ops-registry-snapshot-meta/v1"
    },
    "registry_schema_version": 5,
    "matching_rule": "A reader must require ALL of profile, disclosure.policy, format and schema version to equal what it was built for. A new policy is a new value, never a silent change to this one."
  },
  "completeness": {
    "marker": {
      "filename_rule": "<snapshot file name> + '.meta.json', in the same directory",
      "required": true
    },
    "publication_order": "snapshot file first, sidecar last",
    "consequence": "A snapshot without its sidecar is INCOMPLETE (a hard kill between the two publishes leaves exactly that). It is not corrupt and not empty; it must be treated as 'no observation'.",
    "checksum": {
      "algorithm": "sha256",
      "field": "snapshot.sha256",
      "covers": "every byte of the snapshot file",
      "does_not_cover": "the sidecar itself",
      "also_bound": [
        "snapshot.bytes",
        "snapshot.file (basename)",
        "consistency.table_row_counts"
      ],
      "is_authenticity": false
    },
    "reference_check": "snapshot-export --verify <snapshot>  (library: verifySnapshotPair)",
    "sidecar_max_bytes": 1048576
  },
  "sidecar": {
    "file_suffix": ".meta.json",
    "encoding": "UTF-8 JSON object",
    "fields": [
