# ICN Configuration Example
# This file demonstrates all available configuration options.
# Copy to ~/.icn/icn.toml or specify with --config flag.

# ============================================================================
# Node Configuration
# ============================================================================

# Data directory for node state, keystore, and databases
# Default: ~/.icn
data_dir = "/home/user/.icn"

# ============================================================================
# Network Configuration
# ============================================================================

[network]

# QUIC listener address for peer-to-peer connections
# Format: "IP:PORT" - Port is UDP
# Default: "0.0.0.0:7777"
listen_addr = "0.0.0.0:7777"

# RPC (JSON-RPC over HTTP) listen port
# Used by icnctl to control the daemon
# Default: 5601
rpc_port = 5601

# Enable mDNS for automatic local network peer discovery
# Set to false for WAN-only deployments
# Default: true
mdns_enabled = true

# Bootstrap peers for initial network connectivity (WAN seed nodes)
# Format: ["icn://did:icn:PEER_DID@IP:PORT"]
# Note: Currently only IP addresses are supported (DNS hostnames will be added later)
# Default: []
bootstrap_peers = []

# Example bootstrap configuration (commented out):
# bootstrap_peers = [
#     "icn://did:icn:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK@203.0.113.50:7777",
#     "icn://did:icn:z6MkpTHR8VNsBxYAAWHut2Geadd9jSwuBV8xRoAnwWsdvktH@203.0.113.51:7777"
# ]

# ============================================================================
# Observability Configuration
# ============================================================================

[observability]

# Prometheus metrics exporter port (HTTP)
# Metrics exposed at http://0.0.0.0:<port>/metrics
# Default: 9100
metrics_port = 9100

# Health check endpoint port (HTTP)
# Health status at http://0.0.0.0:<port>/health
# Default: 8080
health_port = 8080

# Log level for structured logging
# Options: "trace", "debug", "info", "warn", "error"
# Default: "info"
log_level = "info"

# ============================================================================
# Rate Limiting Configuration (Trust-Gated)
# ============================================================================
# Trust-gated rate limiting provides different message rate limits based on
# peer trust classification. This protects against DoS attacks while allowing
# trusted peers higher throughput.

[rate_limiting]

# Enable trust-gated rate limiting
# Default: true
enabled = true

# Token bucket refill interval (milliseconds)
# How often tokens are added back to peer buckets
# Default: 100
refill_interval_ms = 100

# Rate limits for Isolated peers (trust score 0.0 - 0.1)
# These are untrusted or newly connected peers
[rate_limiting.isolated]
max_messages_per_second = 10
burst_capacity = 2

# Rate limits for Known peers (trust score 0.1 - 0.4)
# These have basic trust but limited history
[rate_limiting.known]
max_messages_per_second = 50
burst_capacity = 10

# Rate limits for Partner peers (trust score 0.4 - 0.7)
# These are trusted collaborators
[rate_limiting.partner]
max_messages_per_second = 100
burst_capacity = 20

# Rate limits for Federated peers (trust score 0.7 - 1.0)
# These are highly trusted federation members
[rate_limiting.federated]
max_messages_per_second = 200
burst_capacity = 50

# Fallback rate limits when trust graph is unavailable
# Used during startup or if trust computation fails
[rate_limiting.fallback]
max_messages_per_second = 100
burst_capacity = 20

# ============================================================================
# Topology Configuration (Regional/Cluster-Based Federation)
# ============================================================================
# Topology-aware networking enables efficient regional and cluster-based
# message routing. Nodes categorize peers based on geographic/logical location
# and trust scores, optimizing gossip propagation.

[topology]

# Geographic region identifier
# Used to group nodes into regional clusters for efficient routing
# Examples: "us-west", "eu-central", "ap-southeast"
# Default: "" (topology disabled)
region = "us-west"

# Cluster identifier within the region
# Groups nodes that should coordinate tightly (e.g., same data center)
# Examples: "sfo-1", "lax-2", "pdx-1"
# Default: "" (topology disabled)
cluster_id = "sfo-1"

# Node role in the network topology
# Options:
#   - "edge": Regular node (default)
#   - "rendezvous": Bootstrap/discovery hub
#   - "archive": Long-term storage node
# Default: "edge"
role = "edge"

# Neighbor set size limits (prevents unbounded memory usage)
# These limits are enforced per category with LRU eviction
[topology.neighbor_limits]

# Maximum local cluster neighbors (same region + cluster_id)
# These are the tightest coordinated peers
# Default: 50
max_local_cluster = 50

# Maximum regional neighbors (same region, different cluster)
# Cross-cluster peers within the same geographic region
# Default: 30
max_regional = 30

# Maximum backbone neighbors (different region)
# Cross-regional connectivity for global propagation
# Default: 20
max_backbone = 20

# Maximum trusted neighbors (high trust score >= 0.7)
# Highly trusted peers override location limits
# Default: 100
max_trusted = 100

# Gossip fanout configuration per scope
# Controls how many peers receive each gossip message
[topology.fanout]

# Local cluster fanout (tight coordination)
# Higher fanout ensures fast convergence within cluster
# Default: 8
local_cluster = 8

# Regional fanout (cross-cluster sync)
# Medium fanout balances latency and bandwidth
# Default: 6
regional = 6

# Global fanout (cross-regional propagation)
# Lower fanout minimizes WAN traffic
# Default: 4
global = 4

# ============================================================================
# Topology Configuration Examples
# ============================================================================
#
# Example 1: Edge node in US West, San Francisco cluster
# [topology]
# region = "us-west"
# cluster_id = "sfo-1"
# role = "edge"
#
# Example 2: Rendezvous node in EU Central (no specific cluster)
# [topology]
# region = "eu-central"
# cluster_id = "hub-1"
# role = "rendezvous"
#
# Example 3: Archive node for long-term storage
# [topology]
# region = "us-east"
# cluster_id = "nyc-archive"
# role = "archive"
#
# To disable topology-aware networking, omit the [topology] section entirely
# or set region = "" and cluster_id = "".

# ============================================================================
# PLANNED FEATURES (Not Yet Implemented)
# ============================================================================
# The following sections are shown for completeness but are not yet supported.
# They will be implemented in future releases.

# [identity]
# # DID for this node (auto-generated if not specified)
# did = "did:icn:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK"
#
# # Key rotation grace period (seconds)
# rotation_grace_period = 86400  # 24 hours

# [rpc]
# # JSON-RPC over HTTP listener address
# # Default: "0.0.0.0:5050"
# listen_addr = "0.0.0.0:5050"
#
# # Enable TLS for RPC endpoint
# # Default: false (uses HTTP in development)
# tls_enabled = false

# [trust]
# # Trust computation policy
# # Options: "default", "strict", "permissive"
# # Default: "default"
# policy = "default"
#
# # Trust score thresholds for access classes
# [trust.thresholds]
# isolated = 0.0   # Untrusted
# known = 0.1      # Basic interaction
# partner = 0.4    # Trusted collaboration
# federated = 0.7  # Full cooperation

# [gossip]
# # Maximum entries per topic (prevents unbounded growth)
# # Default: 1000
# max_entries_per_topic = 1000
#
# # Compression threshold (bytes)
# # Entries larger than this are compressed with zstd
# # Default: 1024 (1KB)
# compression_threshold = 1024
#
# # Anti-entropy digest interval (milliseconds)
# # Default: 10000 (10 seconds)
# digest_interval_ms = 10000

# [ledger]
# # Quarantine conflicting entries instead of rejecting
# # Default: true
# merge_quarantine_on_conflict = true
#
# # Maximum journal entries before compaction
# # Default: 10000
# max_journal_size = 10000

# [contracts]
# # Maximum fuel per contract execution
# # Default: 1000000
# max_fuel = 1000000
#
# # Maximum expression depth (prevents stack overflow)
# # Default: 50
# max_expression_depth = 50
