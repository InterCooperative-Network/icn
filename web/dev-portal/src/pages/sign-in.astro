---
import BaseLayout from "../layouts/BaseLayout.astro";
const url = new URL(Astro.request.url);
const next = url.searchParams.get("next") ?? "/inside";
const denied = url.searchParams.get("denied");
---
<BaseLayout title="Sign in" description="Sign in to icn.zone — the inside of the development kingdom.">
  <div class="sign-in-card">
    <h1>Sign in</h1>
    <p>icn.zone has an inside. Signing in opens the team's coordination space — feed, notices, standups, deploy ops. The public surface of icn.zone stays open whether you're signed in or not.</p>

    {denied && (
      <div class="card" style="background: var(--tone-critical-bg); color: var(--tone-critical-fg); border-color: var(--tone-critical-fg); margin-bottom: 16px;">
        <strong>Access denied.</strong>
        <div style="font-size: 13px; margin-top: 4px;">{denied}</div>
      </div>
    )}

    <a href={`/api/auth/github?next=${encodeURIComponent(next)}`} class="btn primary">Sign in with GitHub</a>

    <p style="font-size: 12px; margin-top: 20px; color: var(--text-muted);">
      Standing today is held by membership in the <a href="https://github.com/InterCooperative-Network">InterCooperative-Network</a> GitHub org. <strong>Future</strong>: ICN identity (<code>did:icn:…</code>) verified through the substrate. See <a href="https://github.com/InterCooperative-Network/icn/blob/main/web/dev-portal/content/scope-doctrine.md">scope doctrine</a>.
    </p>

    <details style="margin-top: 16px;">
      <summary style="cursor: pointer; font-size: 12px; color: var(--text-muted);">Dev mode</summary>
      <p style="font-size: 12px; margin-top: 8px;">
        In development without GitHub OAuth wired up, you can mock a session at
        <a href={`/api/auth/mock?login=fahertym&next=${encodeURIComponent(next)}`}><code>/api/auth/mock?login=fahertym</code></a>.
        This endpoint is disabled when <code>NODE_ENV=production</code>.
      </p>
    </details>
  </div>
</BaseLayout>
