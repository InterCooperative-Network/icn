# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# synced content — no longer used (docs read directly from repo root)
src/content/docs/

# generated at build time by scripts/gen-stats.mjs
src/data/stats.json

# projections of canonical repo state, regenerated on every build by
# `npm run generate`. Never edit or commit these — edit the source they are
# derived from (named in each file's `source` field) and rebuild.
src/data/*.generated.json

# Reviewable output of scripts/check-docs-boundary.mjs. Regenerated on every
# run; the committed docs-boundary-baseline.json is the tracked expectation.
public-docs-manifest.json

# Generated reports (scripts/audit-layout.mjs --json,
# scripts/check-links.mjs --report-json)
layout-audit*.json
link-report.json
