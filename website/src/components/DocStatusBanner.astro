---
// DocStatusBanner.astro — the status strip at the top of a rendered doc page.
//
// #2609: "Historical/session/undated material is visually unmistakable when
// opened." Before this, an archived 2025 sprint report and the current
// architecture document rendered identically — same layout, same typography,
// no date, no status. A visitor arriving from a search engine had no way to
// know which one they were reading.
//
// The banner has two forms:
//
//   archive  — a full interruption. Amber, bordered, states plainly that the
//              page is historical, says why, and links to the replacement when
//              the registry knows one.
//   current  — a quiet metadata line: layer, canonical flag, last reviewed.
//              Present on every page so its absence never has to be
//              interpreted, and so "no banner" can't be mistaken for
//              "definitely current".
//
// The distinction never rests on colour. The archive form leads with the word
// "Historical" and repeats the status in text.

import type { PublishedDoc } from "../lib/docsClassification";

export interface Props {
  doc: PublishedDoc;
}

const { doc } = Astro.props;

const isArchive = doc.layer === "archive";

// `superseded_by` in frontmatter is written a few different ways across the
// corpus: a bare path, a docs-relative path, or a filename. Normalise to a
// site URL when it looks resolvable, otherwise show it as plain text rather
// than fabricating a link that 404s.
function supersededHref(ref: string | null): string | null {
  if (!ref) return null;
  const cleaned = ref.trim().replace(/^\.\//, "");
  if (/^https?:\/\//.test(cleaned)) return cleaned;
  if (!cleaned.endsWith(".md")) return null;
  const withoutDocs = cleaned.replace(/^docs\//, "");
  return `/docs/${withoutDocs.replace(/\.md$/, "")}`;
}

const replacementHref = supersededHref(doc.supersededBy);
---

{
  isArchive ? (
    <aside class="callout callout-archive doc-banner" aria-labelledby="doc-banner-title">
      <span class="callout-label" id="doc-banner-title">
        Historical document — not current project state
      </span>
      <p>
        This page is kept for the record. It described the project at the time it
        was written and has not been maintained since. Do not read it as a
        statement about how ICN works today.
      </p>
      <dl class="doc-banner-meta">
        <div>
          <dt>Classification</dt>
          <dd>{doc.archiveReason ?? "historical"}</dd>
        </div>
        {doc.lastReviewed && doc.lastReviewed !== "unknown" && (
          <div>
            <dt>Last reviewed</dt>
            <dd>{doc.lastReviewed}</dd>
          </div>
        )}
        {doc.supersededBy && (
          <div>
            <dt>Replaced by</dt>
            <dd>
              {replacementHref ? (
                <a href={replacementHref}>{doc.supersededBy}</a>
              ) : (
                doc.supersededBy
              )}
            </dd>
          </div>
        )}
      </dl>
      <p class="doc-banner-actions">
        For current material, start at <a href="/docs">the documentation index</a>,
        or read <a href="/whats-real-now">What's real now</a> for the maturity
        account of each subsystem.
      </p>
    </aside>
  ) : (
    <div class="doc-status" role="note">
      <span class="doc-status-item">
        <span class="doc-status-key">Section</span>
        <span class="doc-status-value">{doc.layer === "decisions" ? "Decision record" : doc.layer === "learn" ? "Learn" : "Current reference"}</span>
      </span>
      {doc.canonical && (
        <span class="doc-status-item">
          <span class="doc-status-key">Status</span>
          <span class="doc-status-value">Canonical</span>
        </span>
      )}
      {doc.status && !doc.canonical && (
        <span class="doc-status-item">
          <span class="doc-status-key">Status</span>
          <span class="doc-status-value">{doc.status}</span>
        </span>
      )}
      {doc.lastReviewed && doc.lastReviewed !== "unknown" && (
        <span class="doc-status-item">
          <span class="doc-status-key">Last reviewed</span>
          <span class="doc-status-value">{doc.lastReviewed}</span>
        </span>
      )}
    </div>
  )
}

<style>
  .doc-banner {
    margin-top: 0;
    margin-bottom: var(--space-xl);
  }

  .doc-banner-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin: var(--space-md) 0;
  }

  .doc-banner-meta dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .doc-banner-meta dd {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .doc-banner-actions {
    margin-bottom: 0;
  }

  /* Current-page metadata: a quiet strip, not a callout. It should be
     available without competing with the document's own first heading. */
  .doc-status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .doc-status-item {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
    min-width: 0;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .doc-status-key {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .doc-status-value {
    color: var(--text-secondary);
  }
</style>
