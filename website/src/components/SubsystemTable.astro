---
// SubsystemTable.astro — the generated per-subsystem state view (#1369).
//
// Everything rendered here comes from src/data/project-state.generated.json,
// which scripts/gen-project-state.mjs projects from docs/status.toml. There is
// no hand-maintained copy of these claims on the website, which is the point:
// the previous website-owned roadmap.json had drifted a month behind the
// canonical file with nothing to detect it.
//
// ─── Reading the two columns ─────────────────────────────────────────────────
//
// Maturity and evidence are separate columns because they are separate
// questions, and collapsing them is how "we merged the code" turns into "it is
// ready". A subsystem can be `strong` and `fixture-backed` at the same time —
// well-built, and demonstrated only against prepared data. Both columns are
// always shown; neither is ever inferred from the other.
//
// ─── Layout ──────────────────────────────────────────────────────────────────
//
// A real <table> at wide widths, because this is tabular data and a screen
// reader user benefits from row/column semantics. Below 900px each row becomes
// a stacked block via CSS only — the markup stays a table, so the semantics
// survive the reflow and nothing needs a second DOM.

import MaturityBadge from "./MaturityBadge.astro";
import EvidenceBadge from "./EvidenceBadge.astro";
// The row shape is defined once, in the typed accessor for the generated
// projection. Re-declaring it here let the two drift: when `evidenceNotes` was
// dropped from the projection (it was leaking a deployment-liveness claim),
// this file still declared it and the build failed with a mismatch nobody
// could act on. One definition, imported.
import type { Subsystem } from "../lib/projectState";

export interface Props {
  subsystems: Subsystem[];
  /** Show the per-subsystem gap list. Long, so it is opt-in. */
  showGaps?: boolean;
}

const { subsystems, showGaps = true } = Astro.props;
---

<div class="scroll-x subsystem-scroll" tabindex="0" role="region" aria-label="Subsystem maturity table">
  <table class="data-table subsystem-table">
    <caption class="sr-only">
      Per-subsystem maturity and evidence, generated from docs/status.toml.
      Each row lists the subsystem, its maturity band, what kind of evidence
      backs the claim, the date it was last verified, and the gaps the project
      records against it.
    </caption>
    <thead>
      <tr>
        <th scope="col">Subsystem</th>
        <th scope="col">Maturity</th>
        <th scope="col">Evidence</th>
        <th scope="col">Verified</th>
        {showGaps && <th scope="col">Recorded gaps</th>}
      </tr>
    </thead>
    <tbody>
      {subsystems.map((s) => (
        <tr id={`sub-${s.id}`}>
          <th scope="row" class="subsystem-name">
            <span class="subsystem-name-label">{s.name}</span>
            {s.crates.length > 0 && (
              <span class="subsystem-crates">{s.crates.join(", ")}</span>
            )}
          </th>
          <td data-label="Maturity">
            <MaturityBadge band={s.band} />
          </td>
          <td data-label="Evidence">
            <EvidenceBadge
              evidence={s.evidence.id}
              label={s.evidence.label}
              detail={s.evidence.detail}
            />
          </td>
          <td data-label="Verified">
            <time datetime={s.lastVerified} class="subsystem-date">{s.lastVerified}</time>
          </td>
          {showGaps && (
            <td data-label="Recorded gaps">
              {s.gaps.length === 0 ? (
                <span class="subsystem-nogaps">None recorded</span>
              ) : (
                <details class="subsystem-gap-details">
                  <summary>
                    {s.gaps.length} recorded {s.gaps.length === 1 ? "gap" : "gaps"}
                  </summary>
                  <ul class="subsystem-gaps">
                    {s.gaps.map((gap) => <li>{gap}</li>)}
                  </ul>
                </details>
              )}
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Progressive enhancement only. Each gap list is a native <details>, so every
  // gap is in the HTML and reachable with one activation with no script at all
  // (the phone default, where the lists made the page very long). With script,
  // wide viewports open them so the table reads as a table, and printing opens
  // them so a printed copy is not missing the gaps.
  const details = document.querySelectorAll<HTMLDetailsElement>(".subsystem-gap-details");
  const wide = window.matchMedia("(min-width: 900px)");
  const setOpen = (open: boolean) => details.forEach((d) => (d.open = open));
  if (details.length > 0) {
    if (wide.matches) setOpen(true);
    window.addEventListener("beforeprint", () => setOpen(true));
  }
</script>

<style>
  .subsystem-gap-details summary {
    cursor: pointer;
    min-height: var(--target-min, 44px);
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--accent-teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .subsystem-gap-details[open] > summary {
    margin-bottom: var(--space-xs);
  }

  /* The anchor target is the row, not its name cell: without this a jump from
     the short version lands the row under the fixed 64px header. */
  .subsystem-table tr[id] {
    scroll-margin-top: calc(64px + var(--space-md));
  }

  .subsystem-scroll {
    margin: var(--space-xl) 0;
  }

  .subsystem-table {
    min-width: 100%;
  }

  .subsystem-name {
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
    min-width: 12ch;
  }

  .subsystem-name-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-heading);
    text-transform: none;
    letter-spacing: 0;
  }

  .subsystem-crates {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    margin-top: 0.15em;
    overflow-wrap: anywhere;
  }

  .subsystem-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .subsystem-gaps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 46ch;
  }

  .subsystem-gaps li {
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-muted);
    padding-left: var(--space-md);
    position: relative;
  }

  .subsystem-gaps li::before {
    content: "—";
    position: absolute;
    left: 0;
  }

  .subsystem-nogaps {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-style: italic;
  }

  /* Stacked layout below 900px. The table element is kept — only its display
     changes — so row and header association survives for assistive tech even
     though the visual grid is gone. Each cell grows a label from its
     data-label attribute so the column meaning is not lost with the header. */
  @media (max-width: 899px) {
    .subsystem-table thead {
      /* Visually hidden, not display:none — the header cells still exist for
         the accessibility tree. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .subsystem-table,
    .subsystem-table tbody,
    .subsystem-table tr,
    .subsystem-table th,
    .subsystem-table td {
      display: block;
      width: auto;
    }

    /* A row is a compact wrapped card: the name on its own line, then
       maturity, evidence and date side by side where they fit, then the gaps.
       Stacking all of them one per line was most of the page's phone height. */
    .subsystem-table tr {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 0 var(--space-md);
      border: 1px solid var(--border-default);
      border-radius: var(--radius-lg);
      background: var(--bg-card);
      padding: var(--space-md) var(--space-lg);
      margin-bottom: var(--space-md);
    }

    .subsystem-table tr > th {
      flex: 1 1 100%;
    }

    .subsystem-table tr > td:last-child {
      flex: 1 1 9rem;
    }

    /* The summary ("3 recorded gaps") already names the cell, so the generated
       label above it would only repeat it. */
    .subsystem-table td[data-label="Recorded gaps"]::before {
      display: none;
    }

    .subsystem-table th,
    .subsystem-table td {
      border-bottom: none;
      padding: var(--space-xs) 0;
    }

    .subsystem-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 0.25em;
    }

    .subsystem-name {
      padding-bottom: var(--space-sm);
      margin-bottom: var(--space-sm);
      border-bottom: 1px solid var(--border-subtle);
    }
  }
</style>
