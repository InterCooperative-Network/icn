---
// FragmentationFigure.astro — the "today vs ICN" comparison (#2612 §2).
//
// The argument this figure has to make is not "ICN has more features". It is
// that an institution's authority and memory are currently *scattered across
// systems that do not know about each other*, and that the cost of that is
// paid in reconstruction — nobody can answer "why were we allowed to do this?"
// without doing archaeology across six tools.
//
// ─── Why this is markup, not an image or an SVG ──────────────────────────────
//
// Two lists, styled. That means:
//
//   - the text equivalent is the markup itself, rather than an alt attribute
//     that has to be maintained alongside a picture and inevitably drifts;
//   - it reflows at 320px and at 200% zoom for free;
//   - it costs nothing on a slow connection;
//   - a screen reader reads a comparison of two labelled lists, which is what
//     the figure actually is.
//
// ─── What it must not become ─────────────────────────────────────────────────
//
// docs/design/MUST_NOT_SHIP.md item 9: "A glowing globe with arcs is not a
// network diagram" and "A central hub with spokes is not federation; it is
// hub-and-spoke architecture." The ICN side is deliberately drawn as a spine
// with stations on it — a sequence that closes — and never as a hub with
// things radiating off it, because a hub is the wrong claim about what ICN is.

interface Fragment {
  label: string;
  holds: string;
}

/** Where an institution's authority and memory currently live. */
const TODAY: Fragment[] = [
  { label: 'Chat', holds: 'The discussion that led to the decision' },
  { label: 'Documents', holds: 'The rule everyone is meant to follow' },
  { label: 'Voting tool', holds: 'The decision itself' },
  { label: 'Spreadsheets', holds: 'Who is a member, and since when' },
  { label: 'Accounting', holds: 'What the decision cost' },
  { label: 'Task tracker', holds: 'Whether anyone did it' },
  { label: 'Cloud vendor', holds: 'All of the above, on their terms' },
];

/** The same institutional functions, on one spine that closes. */
const CONNECTED: Fragment[] = [
  { label: 'Members', holds: 'Who is recognized here, and provably so' },
  { label: 'Rules', holds: 'What the institution has agreed to' },
  { label: 'Decisions', holds: 'What it decided, under those rules' },
  { label: 'Action', holds: 'What was actually done about it' },
  { label: 'Proof', holds: 'A record of why that was allowed' },
  { label: 'Memory', holds: 'All of it, still connected, years later' },
];
---

<figure class="frag">
  <figcaption class="sr-only">
    A comparison of where an institution's authority and memory live today
    versus how ICN connects them. Today's column lists seven separate systems,
    each holding one fragment. The ICN column lists six connected stages that
    form a single loop.
  </figcaption>

  <div class="frag-grid">
    <section class="frag-side frag-today" aria-labelledby="frag-today-title">
      <h3 id="frag-today-title" class="frag-title">
        <span class="frag-title-kicker">Today</span>
        Seven systems, none of which know about each other
      </h3>
      <ul class="frag-list">
        {TODAY.map((f) => (
          <li class="frag-item">
            <span class="frag-label">{f.label}</span>
            <span class="frag-holds">{f.holds}</span>
          </li>
        ))}
      </ul>
      <p class="frag-note">
        Every link between these is a person remembering. When that person
        leaves, the link goes with them.
      </p>
    </section>

    <section class="frag-side frag-icn" aria-labelledby="frag-icn-title">
      <h3 id="frag-icn-title" class="frag-title">
        <span class="frag-title-kicker">With ICN</span>
        One sequence, and it closes
      </h3>
      <ol class="frag-list frag-list-connected">
        {CONNECTED.map((f) => (
          <li class="frag-item">
            <span class="frag-label">{f.label}</span>
            <span class="frag-holds">{f.holds}</span>
          </li>
        ))}
      </ol>
      <p class="frag-note">
        Each stage carries a reference to the one before it, so the last one can
        still explain the first.
      </p>
    </section>
  </div>
</figure>

<style>
  .frag {
    margin: var(--space-2xl) 0;
  }

  .frag-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  .frag-side {
    min-width: 0;
  }

  .frag-title {
    font-size: var(--text-lg);
    line-height: 1.35;
    margin-bottom: var(--space-lg);
    max-width: 30ch;
  }

  .frag-title-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }

  .frag-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .frag-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    min-width: 0;
  }

  .frag-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-heading);
  }

  .frag-holds {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Today's tiles are detached: a dashed edge and a slight stagger, so the
     "these do not connect" claim is legible in grayscale and at a glance.
     The stagger is a transform, not a margin, so it does not affect layout
     width and cannot cause horizontal overflow. */
  .frag-today .frag-item {
    border-style: dashed;
    border-color: var(--border-default);
  }

  .frag-today .frag-item:nth-child(even) {
    transform: translateX(6%);
  }

  /* The ICN column is a single connected spine. The connector is a
     pseudo-element on each item rather than a background image, so it
     survives text zoom and reflow. */
  .frag-list-connected {
    gap: 0;
  }

  .frag-icn .frag-item {
    border-left: 3px solid var(--accent-teal);
    border-radius: 0;
    position: relative;
    margin-left: 0;
  }

  .frag-icn .frag-item:first-child {
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-md);
  }

  .frag-icn .frag-item:last-child {
    border-bottom-left-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }

  .frag-icn .frag-item + .frag-item {
    border-top: none;
  }

  .frag-note {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
    margin-top: var(--space-lg);
    max-width: 34ch;
  }

  @media (min-width: 800px) {
    .frag-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4xl);
    }
  }

  /* In forced-colors mode the dashed/solid distinction is the one that has to
     survive, since the accent colour will be replaced. It does — dashed vs
     solid is a border-style, not a colour. */
  @media (forced-colors: active) {
    .frag-item {
      border-color: CanvasText;
    }
  }
</style>
