---
// src/pages/docs/index.astro — documentation landing page.
//
// PRIMARY JOB: get a reader to current reference material, and make the
// existence and status of everything else legible.
//
// ─── What changed for #2609 ──────────────────────────────────────────────────
//
// The index used to list one section per top-level directory of docs/, with
// archive material in a section called "Archive" that looked exactly like
// every other section, and a search index that ranked a 2025 sprint report
// alongside the current architecture document.
//
// The page now has four explicit layers — Learn, Current reference, Decisions,
// Archive — derived from docs/registry.toml rather than from directory names.
// Archive lives on its own page and is excluded from the default search index;
// the reader is told it exists and how to search it, which is the difference
// between hiding history and organising it.

import Layout from '../../layouts/Layout.astro';
import Search from '../../components/Search.astro';
import { sectionsForLayer, entriesForLayers } from '../../lib/docsTree';
import { DOCS_COUNTS, LAYER_META } from '../../lib/docsClassification';

const learnSections = sectionsForLayer('learn', 'Start here');
const referenceSections = sectionsForLayer('reference', 'Core');
const decisionSections = sectionsForLayer('decisions', 'Decisions');

// Default search covers Learn + Current reference + Decisions. Archive is
// deliberately absent — #2609 asks for archive to be "excluded from default
// docs search but remain intentionally searchable", and /docs/archive carries
// its own search over exactly that set.
const searchable = entriesForLayers(['learn', 'reference', 'decisions']);

const LAYER_NAV = [
  { id: 'learn', ...LAYER_META.learn, count: DOCS_COUNTS.learn },
  { id: 'reference', ...LAYER_META.reference, count: DOCS_COUNTS.reference },
  { id: 'decisions', ...LAYER_META.decisions, count: DOCS_COUNTS.decisions },
  { id: 'archive', ...LAYER_META.archive, count: DOCS_COUNTS.archive },
];
---

<Layout
  title="Documentation"
  description="ICN's public documentation, separated into what to learn first, current reference material, the decision record, and a clearly-marked historical archive."
  activeNav="docs"
>
  <section class="section docs-landing">
    <div class="container">
      <header class="docs-head">
        <span class="eyebrow">Documentation</span>
        <h1>Read the system, and know what you are reading.</h1>
        <p class="lede">
          ICN's documentation is written in the open and kept in the repository.
          That includes material which is no longer true — old plans, completed
          phases, superseded decisions. Rather than delete it, we sort it, so a
          page can never quietly present itself as current when it is not.
        </p>
      </header>

      <!-- ═══ THE FOUR LAYERS ═══════════════════════════════════════════════ -->
      <nav class="docs-layers" aria-label="Documentation sections">
        {LAYER_NAV.map((layer) => (
          <a href={layer.href} class:list={['docs-layer', `docs-layer-${layer.id}`]}>
            <span class="docs-layer-count">{layer.count} documents</span>
            <h2>{layer.title}</h2>
            <p>{layer.blurb}</p>
          </a>
        ))}
      </nav>

      <!-- ═══ CURATED PATHS ═════════════════════════════════════════════════ -->
      <section class="docs-pathways" aria-labelledby="docs-pathways-heading">
        <header class="docs-pathways-header">
          <h2 id="docs-pathways-heading">If you don't know what to search for</h2>
          <p class="measure">
            Each path is a short reading sequence assembled from existing pages.
            They are the fastest way into a corpus this size.
          </p>
        </header>

        <ol class="docs-pathways-grid">
          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">01</span>
            <h3>Understand the project</h3>
            <p>What ICN is, what problem it addresses, and how one decision travels through the system.</p>
            <ul>
              <li><a href="/what-is-icn">What is ICN</a></li>
              <li><a href="/why-icn">Why ICN</a></li>
              <li><a href="/how-it-works">How it works</a></li>
              <li><a href="/see-it-work">See it work — a worked example</a></li>
            </ul>
          </li>

          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">02</span>
            <h3>Build or contribute</h3>
            <p>Get the workspace running and find a contribution path that matches the repository as it exists.</p>
            <ul>
              <li><a href="/for-developers">For developers</a></li>
              <li><a href="/docs/GETTING_STARTED">Getting started</a></li>
              <li><a href="/docs/ARCHITECTURE">Architecture overview</a></li>
              <li><a href="/get-involved">Get involved</a></li>
            </ul>
          </li>

          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">03</span>
            <h3>Understand governance</h3>
            <p>How proposals, decisions, mandates, and the kernel/app boundary actually work.</p>
            <ul>
              <li><a href="/docs/architecture/GOVERNANCE_STATE_MACHINE">Governance state machine</a></li>
              <li><a href="/docs/architecture/KERNEL_APP_SEPARATION">Kernel / app separation</a></li>
              <li><a href="/docs/adr/ADR-0018-adr-lifecycle-and-canonical-decision-index">ADR-0018 — ADR lifecycle</a></li>
            </ul>
          </li>

          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">04</span>
            <h3>Understand economics and resource governance</h3>
            <p>The vocabulary discipline — obligation, allocation, settlement — and how external bridges are framed.</p>
            <ul>
              <li><a href="/cooperative-economy">The cooperative economy needs its own machinery</a></li>
              <li><a href="/docs/rfcs/RFC-0001-obligation-allocation-settlement-primitives">RFC-0001 — Obligation / allocation / settlement</a></li>
              <li><a href="/docs/design/CONTENT_STYLE_GUIDE">Content style guide</a></li>
            </ul>
          </li>

          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">05</span>
            <h3>Understand federation</h3>
            <p>How distinct cooperatives coordinate without merger — treaties, attestations, cross-institution clearing.</p>
            <ul>
              <li><a href="/docs/architecture/FEDERATION_ACTIONS">Federation actions</a></li>
              <li><a href="/docs/architecture/FEDERATION_INTEROP_CONTRACT">Federation interop contract</a></li>
              <li><a href="/docs/adr/ADR-0013-federation-clearing-adoption-contract">ADR-0013 — Federation clearing adoption</a></li>
            </ul>
          </li>

          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">06</span>
            <h3>Understand design and accessibility</h3>
            <p>The cross-surface design system, content discipline, and the accessibility floor for member-facing surfaces.</p>
            <ul>
              <li><a href="/docs/design/ICN_DESIGN_SYSTEM">ICN design system</a></li>
              <li><a href="/docs/design/ACCESSIBILITY_BASELINE">Accessibility baseline</a></li>
              <li><a href="/docs/design-language/concept-map">Concept map — plain-language vocabulary</a></li>
            </ul>
          </li>

          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">07</span>
            <h3>Check current project state</h3>
            <p>Dated, per-subsystem maturity with the evidence behind each claim. Read this before assuming any subsystem is more finished than it is.</p>
            <ul>
              <li><a href="/whats-real-now">What's real now</a></li>
              <li><a href="/docs/STATE">State — project status</a></li>
              <li><a href="/docs/adr/ADR-0032-website-truth-boundary">ADR-0032 — public claim discipline</a></li>
            </ul>
          </li>

          <li class="docs-pathway">
            <span class="docs-pathway-num" aria-hidden="true">08</span>
            <h3>Run infrastructure</h3>
            <p>Deployment routing and cluster topology for anyone standing a node up themselves.</p>
            <ul>
              <li><a href="/docs/deployment/DEPLOYMENT_GUIDE">Deployment guide</a></li>
              <li><a href="/docs/deployment/ICN_ZONE_ROUTING">Zone routing plan</a></li>
              <li><a href="/docs/operations/deployment/HOMELAB_DEPLOYMENT">Homelab deployment</a></li>
            </ul>
          </li>
        </ol>
      </section>

      <!-- ═══ SEARCH + INDEX ════════════════════════════════════════════════ -->
      <section class="docs-browse" aria-labelledby="docs-browse-heading">
        <h2 id="docs-browse-heading">Browse everything current</h2>
        <p class="measure docs-browse-note">
          Search covers the {searchable.length} current documents below — Learn,
          Current reference, and Decisions. Historical material is
          <a href="/docs/archive">searchable separately</a> so it cannot be
          mistaken for current guidance.
        </p>

        <Search searchList={searchable} />

        <div class="docs-index-grid" id="docs-grid">
          {[
            { label: 'Learn', id: 'learn', sections: learnSections },
            { label: 'Current reference', id: 'reference', sections: referenceSections },
            { label: 'Decisions — ADRs and RFCs', id: 'decisions', sections: decisionSections },
          ].map((layer) => (
            <div class="docs-layer-block" id={layer.id}>
              <h3 class="docs-layer-block-title">{layer.label}</h3>
              <div class="docs-index-cards">
                {layer.sections.map((section) => (
                  <div class="docs-section-card" data-section>
                    <h4>{section.name}</h4>
                    <ul>
                      {section.docs.map((doc) => (
                        <li data-slug={doc.slug}><a href={doc.path}>{doc.title}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </section>

  <script>
    // Search filtering. Sections and whole layer blocks hide when they have no
    // matches, so a filtered view never leaves an empty heading behind.
    const sections = document.querySelectorAll<HTMLElement>('[data-section]');
    const layerBlocks = document.querySelectorAll<HTMLElement>('.docs-layer-block');

    function syncLayerVisibility(): void {
      layerBlocks.forEach((block) => {
        const visible = block.querySelectorAll<HTMLElement>(
          '[data-section]:not([hidden])',
        ).length;
        block.hidden = visible === 0;
      });
    }

    document.addEventListener('search-filter', (event) => {
      const detail = (event as CustomEvent<{ matches: string[] }>).detail;
      const matches = new Set(detail.matches);

      sections.forEach((section) => {
        const items = section.querySelectorAll<HTMLElement>('li[data-slug]');
        let visible = 0;
        items.forEach((item) => {
          const slug = item.getAttribute('data-slug');
          const isMatch = slug !== null && matches.has(slug);
          item.hidden = !isMatch;
          if (isMatch) visible += 1;
        });
        section.hidden = visible === 0;
      });

      syncLayerVisibility();
    });

    document.addEventListener('search-clear', () => {
      sections.forEach((section) => {
        section.hidden = false;
        section
          .querySelectorAll<HTMLElement>('li[data-slug]')
          .forEach((item) => {
            item.hidden = false;
          });
      });
      syncLayerVisibility();
    });
  </script>
</Layout>

<style>
  .docs-landing {
    padding-top: calc(64px + var(--space-3xl));
  }

  .docs-head {
    max-width: var(--measure-wide);
    margin-bottom: var(--space-3xl);
  }

  .docs-head h1 {
    margin: var(--space-md) 0 var(--space-lg);
  }

  /* ─── Layer cards ──────────────────────────────────────────────────────── */

  .docs-layers {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-4xl);
  }

  .docs-layer {
    display: block;
    padding: var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--accent-teal);
    border-radius: var(--radius-lg);
    color: inherit;
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .docs-layer:hover {
    border-color: var(--border-teal);
    border-left-color: var(--accent-teal);
  }

  /* Archive is visually distinct from the three current layers — a different
     accent and a dashed left edge, so it reads as a different kind of thing
     even before the label is read. The label still carries the meaning. */
  .docs-layer-archive {
    border-left-style: dashed;
    border-left-color: var(--accent-amber);
    background: var(--bg-surface);
  }

  .docs-layer-archive:hover {
    border-left-color: var(--accent-amber);
    border-color: var(--border-accent);
  }

  .docs-layer-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .docs-layer h2 {
    font-size: var(--text-xl);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .docs-layer p {
    font-size: var(--text-sm);
    margin: 0;
  }

  /* ─── Browse ───────────────────────────────────────────────────────────── */

  .docs-browse {
    margin-top: var(--space-4xl);
  }

  .docs-browse-note {
    margin: var(--space-md) 0 var(--space-xl);
    font-size: var(--text-sm);
  }

  .docs-layer-block {
    margin-top: var(--space-3xl);
  }

  .docs-layer-block-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-lg);
  }

  .docs-index-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .docs-section-card h4 {
    font-size: var(--text-md);
    margin-bottom: var(--space-sm);
  }

  .docs-section-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .docs-section-card li a {
    display: block;
    padding: 0.35rem 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .docs-section-card li a:hover,
  .docs-section-card li a:focus-visible {
    color: var(--accent-teal);
  }

  /* ─── Pathways ─────────────────────────────────────────────────────────── */

  .docs-pathways-header h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-sm);
  }

  .docs-pathways-grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .docs-pathway {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .docs-pathway-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-teal);
  }

  .docs-pathway h3 {
    font-size: var(--text-md);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .docs-pathway > p {
    font-size: var(--text-sm);
    margin-bottom: var(--space-md);
  }

  .docs-pathway ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .docs-pathway li a {
    display: block;
    padding: 0.3rem 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* ─── Wider viewports ──────────────────────────────────────────────────── */

  @media (min-width: 640px) {
    .docs-layers,
    .docs-index-cards,
    .docs-pathways-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .docs-layers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .docs-index-cards,
    .docs-pathways-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
