---
// glossary.astro — the public vocabulary page.
//
// PRIMARY JOB: be the place a `<Term>` can send someone when they want the
// fuller meaning of an ICN word.
//
// ─── Why this is not /docs/glossary ──────────────────────────────────────────
//
// `docs/glossary.md` exists and is published, but it is a technical glossary
// organised by subsystem — DID, trust class, sybil resistance, mutual credit.
// It is the right reference for a developer and the wrong destination for a
// visitor who just read "who counts as a member here (standing)" and wants one
// more sentence about what standing means.
//
// It also has no anchor for most of the concepts the site names inline, so
// linking `<Term>` at it produced dead fragments — caught by
// scripts/check-links.mjs, which is what prompted building this page.
//
// ─── Generated, not authored ─────────────────────────────────────────────────
//
// Every entry comes from docs/design-language/concept-map.md via
// gen-concepts.mjs. The anchors are the canonical concept ids, so a `<Term>`
// link is stable against rewording: changing a public label in the concept map
// moves the text on this page without breaking any link to it.

import Layout from '../layouts/Layout.astro';
import { CONCEPT_IDS, concept, CONCEPT_SOURCE } from '../lib/concepts';

/** Group in concept-map order, preserving its own grouping. */
const groups: Array<{ name: string; concepts: ReturnType<typeof concept>[] }> = [];
for (const id of CONCEPT_IDS) {
  const c = concept(id);
  const name = c.group ?? 'Concepts';
  let group = groups.find((g) => g.name === name);
  if (!group) {
    group = { name, concepts: [] };
    groups.push(group);
  }
  group.concepts.push(c);
}
---

<Layout
  title="Vocabulary"
  description="Plain-language definitions of the words ICN uses — what each one means in ordinary terms, and the internal term it corresponds to."
  activeNav="glossary"
>
  <section class="section gl-hero">
    <div class="container">
      <div class="gl-hero-inner">
        <span class="eyebrow">Vocabulary</span>
        <h1>What the words mean.</h1>
        <p class="lede">
          ICN uses a small number of words precisely. Each one below leads with
          what it means in ordinary language; the internal term the code and
          documentation use is named alongside it.
        </p>
        <p class="sublede">
          Looking for technical reference — DIDs, trust classes, mutual credit
          mechanics? That is the <a href="/docs/glossary">technical glossary</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <nav class="gl-jump" aria-label="Jump to a group">
        {groups.map((g) => (
          <a href={`#${g.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.name}</a>
        ))}
      </nav>

      {groups.map((g) => (
        <section
          class="gl-group"
          id={g.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}
          aria-labelledby={`h-${g.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
        >
          <h2 id={`h-${g.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.name}</h2>
          <dl class="gl-list">
            {g.concepts.map((c) => (
              <div class="gl-entry" id={c.canonical}>
                <dt>
                  <span class="gl-plain">{c.public}</span>
                  <span class="gl-canonical">
                    ICN calls this <b>{c.canonical.replace(/_/g, ' ')}</b>
                    {c.loopPosition && <span class="gl-station"> · loop station {c.loopPosition}</span>}
                  </span>
                </dt>
                <dd>{c.short}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      <p class="figure-note">
        Generated from <code>{CONCEPT_SOURCE}</code>, the design language's
        canonical concept map. The website never authors a public label for an
        ICN concept — if wording here should change, it changes there.
      </p>
    </div>
  </section>
</Layout>

<style>
  .gl-hero {
    padding-top: calc(64px + var(--space-3xl));
  }

  .gl-hero-inner {
    max-width: var(--measure-wide);
  }

  .gl-hero h1 {
    margin: var(--space-md) 0 var(--space-lg);
  }

  .gl-hero .sublede {
    margin-top: var(--space-md);
  }

  .gl-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
  }

  .gl-jump a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    min-height: var(--target-min);
    display: inline-flex;
    align-items: center;
  }

  .gl-group {
    margin-bottom: var(--space-4xl);
    scroll-margin-top: 88px;
  }

  .gl-group h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-xl);
  }

  .gl-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .gl-entry {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--accent-teal);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    min-width: 0;
    /* Deep links from <Term> land here, clear of the fixed nav. */
    scroll-margin-top: 88px;
  }

  .gl-entry dt {
    margin-bottom: var(--space-sm);
  }

  /* Plain language is the primary reading path; the internal term is named
     underneath and set quieter. Same discipline as the Term component. */
  .gl-plain {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--text-heading);
    line-height: 1.3;
  }

  .gl-canonical {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: 0.15em;
  }

  .gl-canonical b {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .gl-station {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .gl-entry dd {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (min-width: 700px) {
    .gl-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .gl-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
