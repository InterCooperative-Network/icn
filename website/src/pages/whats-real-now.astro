---
// whats-real-now.astro — the public project-state surface (#1369).
//
// PRIMARY JOB: let a reader check every other page on this site against a
// dated, evidenced account of what is actually built.
//
// ─── What changed for #1369 ──────────────────────────────────────────────────
//
// The per-subsystem maturity claims used to be hand-written prose on this page
// and hand-written JSON in src/data/roadmap.json. That was a second project
// tracker, and it drifted: roadmap.json was last touched a month before the
// canonical docs/status.toml it was supposed to reflect.
//
// The subsystem table below is now generated from docs/status.toml on every
// build, and the generator fails the build rather than emitting a partial or
// mis-mapped projection. The editorial framing — the narrative around the
// table — is still written by hand, because judgement about what matters is
// not something a TOML file can carry. What the framing must never do is state
// a per-subsystem claim the table contradicts.
//
// The /roadmap page was folded into this one. Two pages describing project
// state is exactly the duplication #2608 asked us to remove, and separating
// "where we are" from "where we are going" invited the second page to make
// promises the first one wouldn't.
//
// ─── ADR-0032 rule 6 ─────────────────────────────────────────────────────────
//
// "whats-real-now carries a Reviewed: date … do not bump the date without
// re-checking each claim." There are now two dates, because they answer
// different questions and conflating them was hiding staleness:
//
//   Verified   — from docs/status.toml, per subsystem. Generated. Moves only
//                when someone re-verifies the subsystem against source.
//   Reviewed   — the editorial prose below. Hand-set. Moves only when someone
//                re-reads this page's narrative against the table.

import Layout from '../layouts/Layout.astro';
import MaturityGrid from '../components/MaturityGrid.astro';
import MaturityCard from '../components/MaturityCard.astro';
import SubsystemTable from '../components/SubsystemTable.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import ReadingLadder from '../components/ReadingLadder.astro';
import { PROJECT_STATE as projectState, evidenceClassesInUse } from '../lib/projectState';
import buildLog from '../data/build-log.generated.json';

/**
 * Editorial review date for the prose on this page. This is NOT the data
 * freshness date — that comes from the generated projection. Bump this only
 * after re-reading every paragraph below against the generated table.
 */
const PROSE_REVIEWED = '2026-08-17';

const subsystems = projectState.subsystems;

// The legend lists only the evidence classes that actually appear below —
// a legend explaining classes the reader will never encounter is noise.
const evidenceLegend = evidenceClassesInUse();
---

<Layout
  title="What's real now"
  activeNav="whats-real-now"
  description="A dated, per-subsystem account of what ICN has actually built, how each claim is evidenced, and what the project records as still missing. Generated from the repository's own state file."
>
  <!-- ═══ FRAMING ═══════════════════════════════════════════════════════════ -->
  <section class="section wrn-hero">
    <div class="container">
      <div class="wrn-hero-inner">
        <span class="eyebrow">Project state</span>
        <h1>What's real now.</h1>
        <p class="lede">
          ICN's subsystems are at very different stages. This page states which
          ones are load-bearing, which are still moving, and — just as
          importantly — what kind of evidence sits behind each claim. Every
          other page on this site should be readable against this one without
          contradiction.
        </p>

        <div class="wrn-freshness">
          <div class="wrn-freshness-item">
            <span class="wrn-freshness-key">Subsystem data verified</span>
            <time datetime={projectState.newestVerified} class="wrn-freshness-value">
              {projectState.newestVerified}
            </time>
            <span class="wrn-freshness-note">
              Generated from <code>{projectState.source}</code> at build time.
            </span>
          </div>
          <div class="wrn-freshness-item">
            <span class="wrn-freshness-key">Narrative last reviewed</span>
            <time datetime={PROSE_REVIEWED} class="wrn-freshness-value">{PROSE_REVIEWED}</time>
            <span class="wrn-freshness-note">
              The written framing on this page, re-read against the data above.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE TWO AXES ══════════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <h2>How to read this page</h2>
      <p class="sublede">
        Every claim carries two labels, because "how far along is it" and "how
        do we know" are different questions. Collapsing them is how a merged
        pull request quietly becomes a promise.
      </p>

      <div class="wrn-axes">
        <div class="wrn-axis">
          <h3>Maturity — how far along it is</h3>
          <MaturityGrid>
            <MaturityCard band="strong">
              <p>Implemented, integrated, and load-bearing. Capabilities we are prepared to stand behind in public.</p>
            </MaturityCard>
            <MaturityCard band="advancing">
              <p>Actively under development with visible progress. Real, not yet reliable enough to lean on.</p>
            </MaturityCard>
            <MaturityCard band="maturing">
              <p>Serious implementation exists. Surfaces, integrations, or verification are still being finished.</p>
            </MaturityCard>
            <MaturityCard band="notyet">
              <p>Scaffolding exists; the capability does not. We would rather say that than imply a schedule.</p>
            </MaturityCard>
          </MaturityGrid>
        </div>

        <div class="wrn-axis">
          <h3>Evidence — how we know</h3>
          <p class="wrn-axis-note">
            A capability can be well-built and thinly evidenced at the same
            time. This axis says which it is.
          </p>
          <ul class="wrn-evidence-legend">
            {evidenceLegend.map((ev) => (
              <li>
                <EvidenceBadge evidence={ev.id} label={ev.label} />
                <span class="wrn-evidence-detail">{ev.detail}</span>
              </li>
            ))}
          </ul>
          <div class="callout callout-caution">
            <span class="callout-label">What none of these mean</span>
            <p>
              None of the evidence classes above means a capability has been
              run by an institution in ordinary use. ICN has no production
              deployment claim, and activity in the repository is not a
              readiness signal.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE GENERATED TABLE ═══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <h2>Subsystems</h2>
      <p class="sublede">
        Generated from the repository's own state file. The gap column is the
        project's own record of what is missing — it is published rather than
        summarised because a maturity claim without its gaps is marketing.
      </p>

      <SubsystemTable subsystems={subsystems} />

      <p class="figure-note">
        {subsystems.length} subsystems, generated from <code>{projectState.source}</code>.
        Some parts of ICN — membership, receipts and provenance, the
        member-facing shell, and the rehearsal appliance — do not have a row in
        that file and so do not appear above. They are covered in the narrative
        below, and that difference is itself worth knowing: the machine-readable
        record does not yet cover everything the project talks about.
      </p>
    </div>
  </section>

  <!-- ═══ EDITORIAL NARRATIVE ═══════════════════════════════════════════════ -->
  <section class="section band-feature">
    <div class="container">
      <div class="container-reading wrn-prose">
        <h2>What the table does not say</h2>

        <h3>The bounded thing that actually runs</h3>
        <p>
          The current bounded wedge is the <strong>Rehearsal Node</strong>: a
          self-contained, non-production appliance that runs one governed loop
          end to end. An organizer reviews, edits, assigns, previews, and
          digest-bound-confirms a piece of proposed work; a member completes it.
          Both decision points are recorded as durable process receipts, and the
          run exports a secret-free evidence summary.
        </p>
        <p>
          That loop has been witnessed on an assembled image. It is deliberately
          bounded — unsigned, non-production — and the human gates are still
          open: a real organizer walkthrough and a human assistive-technology
          pass have not happened. Rehearsal before belief. No organizer approval
          and no pilot commitment is claimed.
        </p>

        <h3>Where the implementation is ahead of the interface</h3>
        <p>
          The strongest part of ICN is the chain that carries an outcome back
          through the rule that shaped it, the decision that authorized it, and
          the standing that made action legitimate. The weakest part is the
          surface an ordinary member would use to see any of that. The gap
          between those two is the single most honest thing to know about the
          project right now.
        </p>
        <p>
          Federation is the other place worth naming directly. It is a serious
          subsystem with real implementation behind it, and no two cooperatives
          are federating over ICN in ordinary use. Peer connectivity is not
          federation, and a local fixture is not a federation either.
        </p>

        <h3>What has no row in the table at all</h3>
        <p>
          Privacy, zero-knowledge proofs, steward networks, and post-quantum
          cryptography exist as dedicated subsystems or source-level primitives.
          Their runtime integration and member-facing role are not verified, so
          they get no public capability claim here.
        </p>
        <p>
          There is design direction for governed services, service identities,
          tool manifests, and institution-owned tool state. Design direction is
          not implemented service hosting, and this page will not let the two
          blur.
        </p>

        <h3>What this page commits to</h3>
        <p>
          Every capability claim elsewhere on this site belongs in one of the
          maturity bands above and carries one of the evidence classes. If
          something reads as more finished on another page than it does here,
          this page is right and the other page is a defect worth reporting.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ BUILD LOG ═════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <h2>Recent state changes</h2>
      <p class="sublede">
        Meaningful changes that landed and were reviewed — not a commit feed.
        An entry here means something changed and someone reviewed it. It does
        not mean a capability became usable; that question is answered by the
        table above.
      </p>

      <ol class="wrn-log">
        {buildLog.entries.map((entry) => (
          <li class="wrn-log-item">
            <time datetime={entry.date} class="wrn-log-date">{entry.date}</time>
            <span class="wrn-log-class">{entry.class.label}</span>
            <span class="wrn-log-body">
              <span class="wrn-log-desc">{entry.description}</span>
              <a class="wrn-log-link" href={entry.prUrl} target="_blank" rel="noopener">
                #{entry.pr} ↗
              </a>
            </span>
          </li>
        ))}
      </ol>

      <p class="figure-note">
        Newest entry {buildLog.newestEntryDate}. Selected from the last
        {buildLog.scanned} commits: only reviewed, merged changes whose type
        corresponds to a change in what the project does — new behaviour,
        corrections, hardening, recorded decisions, and re-verifications of this
        page's own source data.
      </p>
    </div>
  </section>

  <!-- ═══ CHECK IT YOURSELF ═════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <div class="container-reading">
        <h2>Check any of this directly</h2>
        <ul class="wrn-links">
          <li>
            <a href={`https://github.com/InterCooperative-Network/icn/blob/main/${projectState.source}`} target="_blank" rel="noopener">
              {projectState.source} ↗
            </a>
            <span>The file this page's table is generated from, including the evidence list and gap list for each subsystem.</span>
          </li>
          <li>
            <a href="/docs/STATE">Project state</a>
            <span>The canonical, truth-synced current-state document.</span>
          </li>
          <li>
            <a href="/docs/adr/ADR-0032-website-truth-boundary">ADR-0032 — website truth boundary</a>
            <span>The claim-discipline rules this page is written under.</span>
          </li>
          <li>
            <a href="/see-it-work">See it work</a>
            <span>A worked example of one decision travelling through the system, using the same record shapes.</span>
          </li>
          <li>
            <a href="https://github.com/InterCooperative-Network/icn" target="_blank" rel="noopener">Source on GitHub ↗</a>
            <span>The ground truth. Everything above is downstream of it.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <ReadingLadder current="whats-real-now" />
</Layout>

<style>
  .wrn-hero {
    padding-top: calc(64px + var(--space-3xl));
  }

  .wrn-hero-inner {
    max-width: var(--measure-wide);
  }

  .wrn-hero h1 {
    margin: var(--space-md) 0 var(--space-lg);
  }

  /* ─── Freshness ────────────────────────────────────────────────────────── */

  .wrn-freshness {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--accent-amber);
    border-radius: var(--radius-lg);
  }

  .wrn-freshness-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .wrn-freshness-key {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .wrn-freshness-value {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--text-heading);
  }

  .wrn-freshness-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  /* ─── Axes ─────────────────────────────────────────────────────────────── */

  .wrn-axes {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    align-items: start;
  }

  .wrn-axis h3 {
    font-size: var(--text-md);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-subtle);
  }

  .wrn-axis-note {
    font-size: var(--text-sm);
    margin-top: var(--space-md);
  }

  .wrn-evidence-legend {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .wrn-evidence-legend li {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-start;
    min-width: 0;
  }

  .wrn-evidence-detail {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ─── Prose band ───────────────────────────────────────────────────────── */

  .wrn-prose h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-lg);
  }

  .wrn-prose h3 {
    font-size: var(--text-xl);
    margin: var(--space-2xl) 0 var(--space-md);
  }

  .wrn-prose p {
    margin-bottom: var(--space-md);
  }

  /* ─── Build log ────────────────────────────────────────────────────────── */

  .wrn-log {
    list-style: none;
    margin: var(--space-xl) 0 var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }

  .wrn-log-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem;
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: baseline;
  }

  .wrn-log-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .wrn-log-class {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-teal);
  }

  .wrn-log-body {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: baseline;
    min-width: 0;
  }

  .wrn-log-desc {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    min-width: 0;
  }

  .wrn-log-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .wrn-log-link:hover,
  .wrn-log-link:focus-visible {
    color: var(--accent-teal);
  }

  /* ─── Verify links ─────────────────────────────────────────────────────── */

  .wrn-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .wrn-links li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .wrn-links li a {
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .wrn-links li span {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ─── Wider viewports ──────────────────────────────────────────────────── */

  @media (min-width: 700px) {
    .wrn-freshness {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl);
    }
    .wrn-log-item {
      grid-template-columns: 7rem 11rem minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 1000px) {
    .wrn-axes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4xl);
    }
  }
</style>
