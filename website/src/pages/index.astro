---
// index.astro — the homepage.
//
// PRIMARY JOB: a visitor who has never heard of ICN should understand what it
// is and why it exists before they are asked to do anything.
//
// ─── The reordering (#2608) ──────────────────────────────────────────────────
//
// The previous homepage opened with a hero, then immediately presented a
// "Start Here — choose the right first page" panel and a four-card "Four
// concrete ways to engage" grid. A first-time visitor was asked to classify
// themselves as developer / non-technical contributor / institution / funder
// in the first screen and a half — before anything had explained what the
// project was. #2608 and #1368 both name this directly: explain first, route
// second.
//
// The order below is the one #2608 specifies:
//
//   1  hero                 one claim, one explanation, two ways forward
//   2  the problem          fragmentation, shown rather than asserted
//   3  a concrete story     one cooperative, one decision, in human terms
//   4  what ICN changes     the shift, stated plainly
//   5  the simple model     six stages that map onto the real architecture
//   6  see it work          the walkthrough — the strongest single link here
//   7  what's real now      evidence, positioned as a trust mechanism
//   8  deeper architecture  for readers who want to descend
//   9  participation        role routing, now that the reader can choose
//
// ─── Visual rhythm (#2612) ───────────────────────────────────────────────────
//
// Sections deliberately alternate weight: hero → wide figure → narrow reading
// column → figure → wide band → narrow column → grid. The failure mode this
// avoids is a page made entirely of equally-weighted card grids, where nothing
// leads and the eye has no path through.

import Layout from '../layouts/Layout.astro';
import FragmentationFigure from '../components/FragmentationFigure.astro';
import PublicLoop from '../components/PublicLoop.astro';
import MaturityBadge from '../components/MaturityBadge.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import Icon from '../components/Icon.astro';
import { PROJECT_STATE as projectState, subsystemsInBand } from '../lib/projectState';

// The homepage states the shape of the maturity picture, never a per-subsystem
// claim — those belong on /whats-real-now, where each one carries its evidence
// class and its recorded gaps. Deriving even this summary from the generated
// data means the homepage cannot drift into a rosier account than the
// maturity page gives.
const strongest = subsystemsInBand('strong');
const weakest = subsystemsInBand('notyet');

const PARTICIPATION = [
  {
    icon: 'execution' as const,
    title: 'You write software',
    body: 'Build the workspace, read the architectural guardrails, and pick a scoped first issue. The repository is large and the contribution surface is real.',
    href: '/for-developers',
    cta: 'For developers',
  },
  {
    icon: 'governance' as const,
    title: 'You organize, write, research, or design',
    body: 'Documentation, plain-language review, governance thinking, accessibility testing, translation. None of this requires writing Rust, and the project is short on all of it.',
    href: '/get-involved#organizers',
    cta: 'Non-technical contribution',
  },
  {
    icon: 'federation' as const,
    title: 'You are part of a cooperative or institution',
    body: 'Understand what would actually be involved in evaluating ICN, what it can carry today, and what it plainly cannot. Honest answers before any commitment.',
    href: '/for-cooperatives',
    cta: 'For cooperatives and institutions',
  },
  {
    icon: 'commons' as const,
    title: 'You want to follow or support the work',
    body: 'Watch the repository for project updates, or sustain the engineering directly. No mailing list you would have to trust us to actually send.',
    href: '/get-involved#follow',
    cta: 'Follow or support',
  },
];
---

<Layout
  title="Institutional infrastructure for cooperatives, communities, and federations"
  description="ICN is shared digital infrastructure for democratic institutions. It connects the rules a cooperative sets, the decisions it makes, the actions it takes, and the durable proof of why — on infrastructure its members govern."
  activeNav="home"
>
  <!-- ═══ 1 · HERO ══════════════════════════════════════════════════════════ -->
  <section class="hero-home">
    <div class="container">
      <div class="hero-home-inner">
        <span class="badge badge-teal hero-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          Open infrastructure, built in public
        </span>

        <h1>
          Your cooperative owns its work.<br />
          <span class="hero-accent">It should own its institutional memory too.</span>
        </h1>

        <p class="lede hero-lede">
          The InterCooperative Network is shared digital infrastructure for
          cooperatives, communities, and federations. It connects the rules an
          institution sets, the decisions it makes under them, the actions that
          follow, and the durable proof of why — instead of scattering those
          across six products owned by somebody else.
        </p>

        <div class="hero-actions">
          <a href="/see-it-work" class="btn btn-primary">
            See ICN work
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="/what-is-icn" class="btn btn-secondary">Start reading</a>
        </div>

        <p class="hero-qualifier">
          Under active construction, and honest about it —
          <a href="/whats-real-now">what's real now</a> states what each part of
          the system can and cannot do today.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ 2 · THE PROBLEM ═══════════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">The problem</span>
        <h2>An institution's memory is scattered across tools that don't know about each other.</h2>
        <p class="sublede">
          Every cooperative already has governance, rules, membership, money,
          and work. What it usually doesn't have is any system that holds those
          together — so the connections live in people's heads, and leave when
          they do.
        </p>
      </header>

      <FragmentationFigure />

      <div class="callout callout-note prob-callout">
        <span class="callout-label">The deeper version of the problem</span>
        <p>
          Underneath the operational friction is a dependency problem.
          Democratic institutions are expected to run their internal life on
          systems controlled by outside owners, with outside incentives and
          outside priorities. A cooperative can own its workplace outright and
          still rent its nervous system.
        </p>
        <p>
          <a href="/why-icn" class="link-arrow">Why this is structural, not just inconvenient</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ 3 · A CONCRETE STORY ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="story">
        <header class="sec-head story-head">
          <span class="eyebrow">What this looks like in practice</span>
          <h2>A forty-person cooperative needs to replace a fan.</h2>
        </header>

        <div class="story-cols">
          <div class="story-col">
            <h3 class="story-col-title">
              <span class="story-col-kicker">How it usually goes</span>
            </h3>
            <ol class="story-steps story-steps-today">
              <li>Someone raises it in the shop channel. It scrolls away.</li>
              <li>It comes back at a meeting. The minutes land in a shared drive.</li>
              <li>A vote happens in a separate tool. The result is pasted back into chat.</li>
              <li>Someone orders the fan. The invoice goes to the bookkeeper.</li>
              <li>Eighteen months later, an auditor asks who authorized it.</li>
              <li>Three people spend an afternoon reconstructing the answer.</li>
            </ol>
          </div>

          <div class="story-col">
            <h3 class="story-col-title">
              <span class="story-col-kicker">With ICN</span>
            </h3>
            <ol class="story-steps story-steps-icn">
              <li>The cooperative already has a rule about who decides safety spending.</li>
              <li>The item appears as work needing a decision, with a deadline.</li>
              <li>The person acting can see exactly what authorizes them to act.</li>
              <li>Before confirming, they see what record it will create, and whether it can be undone.</li>
              <li>Completing it produces a receipt that points back at the decision.</li>
              <li>Eighteen months later, the answer is one link, not an afternoon.</li>
            </ol>
          </div>
        </div>

        <p class="story-note">
          Nothing above removes the meeting, the argument, or the judgement.
          The people still decide. What changes is that the decision stops
          evaporating the moment it's made.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ 4 · WHAT ICN CHANGES ══════════════════════════════════════════════ -->
  <section class="section band-feature">
    <div class="container">
      <div class="container-reading">
        <span class="eyebrow">What changes</span>
        <p class="pull">
          Rules stop being documents people are expected to remember, and start
          being the thing that determines what can happen next.
        </p>
        <p>
          That is the whole shift, and it is narrower than "ICN fixes democratic
          institutions." Deliberation, politics, judgement, and responsibility
          stay with people. What the infrastructure contributes is memory,
          continuity, and the ability for an institution to be legible to
          itself — so that running a cooperative rests on something more durable
          than whoever is currently holding the pieces together.
        </p>
        <p>
          It also means an institution can answer questions about its own past
          without depending on a vendor to still exist, still export, and still
          be telling the truth.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ 5 · THE SIMPLE MODEL ══════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">The model</span>
        <h2>Six stages, and the last one feeds the first.</h2>
        <p class="sublede">
          This is the introductory view. Underneath it, ICN models nine
          stations with more precision — the mapping is shown on each stage so
          the simple version is a view of the real thing, not a separate story
          told to newcomers.
        </p>
      </header>

      <PublicLoop />

      <p class="figure-note">
        <a href="/how-it-works" class="link-arrow">See the full nine-station architecture</a>
      </p>
    </div>
  </section>

  <!-- ═══ 6 · SEE IT WORK ═══════════════════════════════════════════════════ -->
  <section class="section see-band">
    <div class="container">
      <div class="see-inner">
        <div class="see-copy">
          <span class="eyebrow">The worked example</span>
          <h2>Watch one decision travel the whole loop.</h2>
          <p class="lede">
            A short guided walkthrough of a fictional cooperative: who counts as
            a member, what needed deciding, which rule permitted it, what would
            happen before anything happened, and the record that can still
            explain it a year later.
          </p>
          <p class="see-meta">
            No account, no download, no command line. Around four minutes.
            Every value in it is invented, and the page says so at every step.
          </p>
          <a href="/see-it-work" class="btn btn-primary">
            Open the walkthrough
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>

        <ol class="see-preview" aria-label="The six steps of the walkthrough">
          <li><span class="see-preview-n">01</span> Someone is recognized by their cooperative</li>
          <li><span class="see-preview-n">02</span> Something comes up that needs a decision</li>
          <li><span class="see-preview-n">03</span> The rules say who may decide it, and why</li>
          <li><span class="see-preview-n">04</span> Before anything happens, you can see what would happen</li>
          <li><span class="see-preview-n">05</span> What happened leaves a record that can be checked</li>
          <li><span class="see-preview-n">06</span> The record joins the institution's memory</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══ 7 · WHAT'S REAL NOW ═══════════════════════════════════════════════ -->
  <section class="section section-alt">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">Current state</span>
        <h2>What is actually built, and how we know.</h2>
        <p class="sublede">
          ICN's subsystems are at very different stages, and the project
          publishes that unevenness rather than averaging it into a
          reassuring summary. Two labels travel with every claim: how far along
          it is, and what kind of evidence sits behind it.
        </p>
      </header>

      <div class="state-summary">
        <div class="state-figure">
          <span class="state-figure-value">{strongest.length} of {projectState.subsystems.length}</span>
          <span class="state-figure-label">
            subsystems in the <MaturityBadge band="strong" /> band
          </span>
          <p>
            {strongest.map((s) => s.name).join(', ')}.
          </p>
        </div>

        <div class="state-figure">
          <span class="state-figure-value">{weakest.length}</span>
          <span class="state-figure-label">
            still <MaturityBadge band="notyet" />
          </span>
          <p>
            {weakest.length > 0
              ? `${weakest.map((s) => s.name).join(', ')} — scaffolding exists, the capability does not.`
              : 'No subsystem is currently in this band.'}
          </p>
        </div>

        <div class="state-figure">
          <span class="state-figure-value state-figure-date">{projectState.newestVerified}</span>
          <span class="state-figure-label">last verified against source</span>
          <p>
            Generated from the repository's own state file on every build, so
            this page cannot quietly fall behind the code.
          </p>
        </div>
      </div>

      <div class="callout callout-caution state-callout">
        <span class="callout-label">What none of this means</span>
        <p>
          ICN has no production deployment claim and no live federation. A
          subsystem can be well-built and still only ever have been exercised
          against prepared data — several are. Evidence labels like
          <EvidenceBadge evidence="fixture-backed" label="Fixture-backed" /> exist
          precisely so that distinction survives contact with a homepage.
        </p>
        <p>
          <a href="/whats-real-now" class="link-arrow">The full per-subsystem account, with recorded gaps</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ 8 · DEEPER ════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">Going deeper</span>
        <h2>If you want the actual system.</h2>
      </header>

      <div class="deeper-grid">
        <a href="/how-it-works" class="deeper-card">
          <h3>How it works</h3>
          <p>The nine stations in full, each with its own maturity band — identity through to the member-facing surface.</p>
        </a>
        <a href="/architecture" class="deeper-card">
          <h3>Architecture</h3>
          <p>The constraint engine, the kernel/app boundary, and why the kernel is deliberately kept ignorant of institutional meaning.</p>
        </a>
        <a href="/cooperative-economy" class="deeper-card">
          <h3>The cooperative economy</h3>
          <p>Why credit unions and CDFIs are bridges to the existing economy, and what machinery the other side of that bridge still lacks.</p>
        </a>
        <a href="/docs" class="deeper-card">
          <h3>Documentation</h3>
          <p>Current reference, the decision record, and a clearly-marked archive of everything that used to be true.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 9 · PARTICIPATION ═════════════════════════════════════════════════ -->
  <section class="section band-feature">
    <div class="container">
      <header class="sec-head">
        <span class="eyebrow">Taking part</span>
        <h2>Now that you know what this is.</h2>
        <p class="sublede">
          Four routes, each leading somewhere that is actually maintained. If a
          path below turns out to be a dead end, that is a bug and we would like
          to hear about it.
        </p>
      </header>

      <div class="part-grid">
        {PARTICIPATION.map((route) => (
          <article class="part-card">
            <span class="part-icon" aria-hidden="true">
              <Icon name={route.icon} size={22} />
            </span>
            <h3>{route.title}</h3>
            <p>{route.body}</p>
            <a href={route.href} class="link-arrow">{route.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── 1 · Hero ─────────────────────────────────────────────────────────── */

  .hero-home {
    padding: calc(64px + var(--space-4xl)) 0 var(--space-4xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-home-inner {
    max-width: 62ch;
  }

  .hero-badge {
    margin-bottom: var(--space-lg);
  }

  .hero-home h1 {
    font-size: var(--text-display);
    line-height: 1.08;
    margin-bottom: var(--space-lg);
  }

  /* At 62ch a 56px display face broke the headline into four short lines with
     half the viewport empty beside it. A wider measure for the headline only —
     the body copy underneath stays at a readable width — lets it set as the
     two lines the markup's line break assumes. */
  @media (min-width: 900px) {
    .hero-home-inner {
      max-width: 74ch;
    }
    .hero-home .hero-lede {
      max-width: 58ch;
    }
    .hero-home .hero-qualifier {
      max-width: 58ch;
    }
  }

  /* The second line of the headline is the claim that does the work, so it
     carries the accent. A single accent colour on one clause — not gradient
     text, which MUST_NOT_SHIP item 8 rejects on anything but the brand name. */
  .hero-accent {
    color: var(--accent-teal);
  }

  .hero-lede {
    font-size: var(--text-xl);
    line-height: 1.55;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .hero-qualifier {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ─── Shared section heads ─────────────────────────────────────────────── */

  .sec-head {
    max-width: var(--measure-wide);
    margin-bottom: var(--space-2xl);
  }

  .sec-head h2 {
    font-size: var(--text-3xl);
    line-height: 1.15;
    margin: var(--space-sm) 0 var(--space-lg);
    max-width: 24ch;
  }

  .prob-callout {
    margin-top: var(--space-2xl);
  }

  /* ─── 3 · Story ────────────────────────────────────────────────────────── */

  .story-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  .story-col {
    min-width: 0;
  }

  .story-col-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .story-col-title {
    font-size: var(--text-md);
    margin-bottom: var(--space-lg);
  }

  .story-steps {
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .story-steps li {
    counter-increment: step;
    position: relative;
    padding-left: 2.25rem;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-secondary);
    min-width: 0;
  }

  .story-steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.1em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* The ICN column's numbers are accented and its steps are connected by a
     rule; today's column is not. The distinction is carried by the connector's
     presence or absence, which survives grayscale. */
  .story-steps-icn li::before {
    color: var(--accent-teal);
  }

  .story-steps-icn li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    top: 1.6em;
    bottom: -0.85rem;
    width: 1px;
    background: var(--border-teal);
  }

  .story-note {
    margin-top: var(--space-2xl);
    font-size: var(--text-md);
    color: var(--text-primary);
    max-width: var(--measure-prose);
    border-left: 3px solid var(--border-default);
    padding-left: var(--space-lg);
  }

  /* ─── 6 · See it work ──────────────────────────────────────────────────── */

  .see-band {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-teal);
    border-bottom: 1px solid var(--border-teal);
  }

  .see-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .see-copy h2 {
    font-size: var(--text-3xl);
    line-height: 1.15;
    margin: var(--space-sm) 0 var(--space-lg);
    max-width: 20ch;
  }

  .see-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: var(--space-lg) 0 var(--space-xl);
  }

  .see-preview {
    list-style: none;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    overflow: hidden;
    min-width: 0;
  }

  .see-preview li {
    display: flex;
    gap: var(--space-md);
    align-items: baseline;
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    min-width: 0;
  }

  .see-preview li + li {
    border-top: 1px solid var(--border-subtle);
  }

  .see-preview-n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-teal);
    flex: none;
  }

  /* ─── 7 · State ────────────────────────────────────────────────────────── */

  .state-summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .state-figure {
    min-width: 0;
    padding-top: var(--space-lg);
    border-top: 2px solid var(--border-default);
  }

  .state-figure-value {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1.1;
  }

  .state-figure-date {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
  }

  .state-figure-label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .state-figure p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .state-callout {
    margin-top: var(--space-2xl);
  }

  /* ─── 8 · Deeper ───────────────────────────────────────────────────────── */

  .deeper-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .deeper-card {
    display: block;
    padding: var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    color: inherit;
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .deeper-card:hover,
  .deeper-card:focus-visible {
    border-color: var(--border-teal);
  }

  .deeper-card h3 {
    font-size: var(--text-md);
    margin-bottom: var(--space-sm);
  }

  .deeper-card p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  /* ─── 9 · Participation ────────────────────────────────────────────────── */

  .part-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .part-card {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
