{
  "name": "Low Trust Environment",
  "description": "Sparse trust network (30% density) to test if economy can function with low social capital.",
  "parameters": {
    "n_agents": 100,
    "simulation_months": 12,
    "seed": 42,
    "credit_policy": {
      "initial_limit": -20,
      "max_limit": -500,
      "growth_rate": 0.1,
      "trust_multiplier": 1.0,
      "demurrage_rate": 0.0,
      "demurrage_threshold": 50,
      "default_threshold": 100,
      "default_period_days": 90,
      "write_off_threshold": 200,
      "ramp_period_months": 3,
      "contribution_requirement": 10
    },
    "agent_type_distribution": {
      "reciprocator": 0.65,
      "hoarder": 0.15,
      "free_rider": 0.08,
      "opportunist": 0.07,
      "super_contributor": 0.05
    },
    "trust_network_density": 0.3
  },
  "hypothesis": "Low trust density causes velocity collapse and network fragmentation",
  "compare_to": "baseline",
  "expected_outcomes": {
    "velocity": "much lower than baseline",
    "network_fragmentation": "isolated clusters",
    "failure_mode": "velocity collapse"
  }
}
