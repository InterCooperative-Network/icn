# ICN Deployment Configuration
#
# Copy this to .env and customize before running docker-compose

# JWT secret for Gateway API authentication
# IMPORTANT: Generate a strong random secret for production
# Example: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-strong-random-secret

# Grafana admin password
GRAFANA_PASSWORD=admin

# Cooperative settings (optional)
COOP_NAME=My Timebank
COOP_CURRENCY=hours
