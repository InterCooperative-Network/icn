# ICN Daemon Environment Configuration
# Copy to /etc/icn/icnd.env and configure

# JWT Secret for Gateway API (REQUIRED)
# Generate with: openssl rand -hex 32
ICN_GATEWAY_JWT_SECRET=your-strong-secret-here

# Optional: Keystore passphrase (not recommended for production)
# Better to use a secrets manager or enter manually
# ICN_KEYSTORE_PASSPHRASE=

# Optional: Custom data directory
# ICN_DATA_DIR=/var/lib/icn

# Optional: Log level (trace, debug, info, warn, error)
# RUST_LOG=info

# Optional: Static files directory for web UI
# ICN_STATIC_DIR=/usr/share/icn/static
