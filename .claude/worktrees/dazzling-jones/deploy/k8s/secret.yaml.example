# Example secret template
# Copy this to secret.yaml and fill in your values
# DO NOT commit secret.yaml to git!
apiVersion: v1
kind: Secret
metadata:
  name: icn-secrets
  namespace: icn
  labels:
    app: icn
type: Opaque
stringData:
  # Keystore passphrase for unlocking identity
  passphrase: "CHANGE_ME"
  # JWT secret for gateway authentication tokens
  # Generate with: openssl rand -base64 32
  jwt-secret: "CHANGE_ME_TO_A_RANDOM_32_BYTE_BASE64_STRING"
---
apiVersion: v1
kind: Secret
metadata:
  name: icn-passphrase
  namespace: icn
  labels:
    app: icn
type: Opaque
stringData:
  passphrase: "CHANGE_ME"

