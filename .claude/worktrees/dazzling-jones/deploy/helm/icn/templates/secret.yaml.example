{{/*
Validate that required secrets are provided.
Fail the deployment if secrets contain placeholders or are empty.
*/}}
{{- $jwtSecret := .Values.icn.secrets.jwtSecret -}}
{{- if or (empty $jwtSecret) (contains "change" (lower $jwtSecret)) (contains "replace" (lower $jwtSecret)) (contains "placeholder" (lower $jwtSecret)) }}
{{- fail "ERROR: icn.secrets.jwtSecret must be set to a secure value. Generate with: openssl rand -base64 32" }}
{{- end }}

{{- $grafanaPassword := .Values.grafana.adminPassword -}}
{{- if and .Values.grafana.enabled (or (empty $grafanaPassword) (eq $grafanaPassword "admin")) }}
{{- fail "ERROR: grafana.adminPassword must be set to a secure value when Grafana is enabled" }}
{{- end }}

apiVersion: v1
kind: Secret
metadata:
  name: {{ include "icn.fullname" . }}-secret
  labels:
    {{- include "icn.labels" . | nindent 4 }}
type: Opaque
stringData:
  jwt-secret: {{ $jwtSecret | quote }}
