{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".github/copilot-instructions.md",
    ".github/instructions/*.md"
  ],
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/target/**",
      "**/dist/**",
      "**/coverage/**",
      "**/test-results/**"
    ]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "git rebase*": "ask",
      "rm *": "ask",
      "cargo publish*": "ask",
      "npm publish*": "ask"
    }
  },
  "agent": {
    "review": {
      "description": "Read-only reviewer (no file edits)",
      "mode": "subagent",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  }
}
