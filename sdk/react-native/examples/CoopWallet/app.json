{
  "expo": {
    "name": "Coop Wallet",
    "slug": "coop-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90A4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.icn.coopwallet"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A90A4"
      },
      "package": "org.icn.coopwallet"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Coop Wallet to access your camera to scan QR codes for payments."
        }
      ]
    ]
  }
}
