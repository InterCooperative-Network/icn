{
  "name": "@icn/client",
  "version": "0.1.0",
  "description": "TypeScript client SDK for ICN Gateway API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "seed": "ts-node examples/seed-demo-data.ts",
    "generate-types": "openapi-typescript ../../docs/api/openapi.yaml -o src/api-types.ts"
  },
  "keywords": [
    "icn",
    "cooperative",
    "mutual-credit",
    "p2p",
    "decentralized"
  ],
  "author": "ICN Contributors",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/icn.git",
    "directory": "sdk/typescript"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "openapi-typescript": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
