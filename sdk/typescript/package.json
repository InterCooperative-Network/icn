{
  "name": "@icn/client",
  "version": "0.1.0",
  "description": "TypeScript client SDK for ICN Gateway API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run generate-types && tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "seed": "ts-node examples/seed-demo-data.ts",
    "generate-types": "openapi-typescript ../../docs/api/openapi.generated.yaml -o src/generated/api-types.ts",
    "check-types": "git diff --exit-code src/generated/"
  },
  "keywords": [
    "icn",
    "cooperative",
    "mutual-credit",
    "p2p",
    "decentralized"
  ],
  "author": "ICN Contributors",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/InterCooperative-Network/icn.git",
    "directory": "sdk/typescript"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.6",
    "@types/ws": "^8.5.10",
    "jest": "^30.2.0",
    "openapi-typescript": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
