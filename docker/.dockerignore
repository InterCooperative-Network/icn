# Docker build context exclusions
# This file reduces the Docker build context size and speeds up builds

# Git
.git/
.gitignore
.github/

# Documentation
docs/
*.md
!README.md

# Docker files
docker/volumes/
docker-compose*.yml

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# Rust build artifacts (will be built inside container)
icn/target/
**/target/
*.lock
!Cargo.lock

# Test artifacts
test-results/
coverage/

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Example/config files (may contain secrets)
config/*.toml
!config/*.example
examples/

# Node/npm (if any)
node_modules/
